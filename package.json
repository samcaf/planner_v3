{
  "name": "planner-v3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A calendar-first planner: projects, scheduled tasks, meetings, and a people directory.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"node --watch-path=./server server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js",
    "plan": "node bin/plan.js",
    "test": "node test/run.mjs"
  },
  "bin": {
    "plan": "./bin/plan.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dompurify": "^3.1.6",
    "express": "^4.19.2",
    "katex": "^0.16.11",
    "marked": "^14.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "jsdom": "^29.1.1",
    "vite": "^5.4.8"
  }
}
